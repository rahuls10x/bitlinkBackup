# Bind addresses: local development defaults
FRONTEND_BIND_IP=127.0.0.1
BACKEND_BIND_IP=127.0.0.1
MINIO_BIND_IP=127.0.0.1

# Host ports
FRONTEND_PORT=5174
BACKEND_PORT=4001
MONGO_PORT=27018
REDIS_PORT=6380
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OAuth client credentials: replace with your registered client
CLIENT_ID=replace_with_client_id
CLIENT_SECRET=replace_with_client_secret

# Local browser URLs
ORIGIN_URL=http://localhost:5174
AUTH_SERVER_URL=http://localhost:4000
RESOURCE_SERVER_URL=http://localhost:5000
REDIRECT_URI=http://localhost:5174/callback

VITE_CLIENT_ID=replace_with_client_id
VITE_REDIRECT_URI=http://localhost:5174/callback
VITE_AUTH_URL=http://localhost:4000/authorize
VITE_API_URL=http://localhost:4001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=bitlink-bucket
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_with_a_strong_password

# MinIO: use strong credentials in your private .env
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_with_a_strong_password


